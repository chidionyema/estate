#!/usr/bin/env bash
# One file, symlinked as every hook name in this directory. It must therefore
# dispatch on the name it was invoked under. Until 2026-08-23 22:04 it did not:
# it ran the pre-push body whatever it was called, so pre-commit and commit-msg
# in every repo without a .githooks/pre-push refused, and no commit could be
# made anywhere on this machine.
set -euo pipefail
on_exit() {
	local e=$?
	[ "$e" -eq 0 ] || echo "_router: hook ${name:-?} exit $e" >&2
}
trap on_exit EXIT
name="$(basename "$0")"

# crew#474 (2026-08-27): every git hook this router dispatches was BLIND on the estate
# showcase ("estate/last-status absent; never observed") because only Claude hooks, run
# through hook-run.py, wrote to the outcomes ledger. A guard nobody can see fire is not
# a guard (LAW 28). Same ledger, same row shape, same reader (inventory guard_outcomes).
LEDGER="${HOOK_OUTCOMES:-$HOME/.claude/state/hook-outcomes.jsonl}"
record() {
	local rc="$1" refused=false
	[ "$rc" != 0 ] && refused=true
	mkdir -p "$(dirname "$LEDGER")" 2>/dev/null || return 0
	printf '{"at":"%s","event":"git-hook","hook":"%s","session":"","exit":%s,"ms":0,"refused":%s}\n' \
		"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$rc" "$refused" >>"$LEDGER" 2>/dev/null || true
}
# Run the chosen hook, record its exit under the name this router was invoked as, and
# exit with that same code. Replaces exec, which left nothing behind to record.
run() {
	set +e
	"$@"
	local rc=$?
	set -e
	record "$rc"
	exit "$rc"
}
top="$(git rev-parse --show-toplevel)"

# A repository under the operating system's temp directory, reached only because ~/.gitconfig
# points core.hooksPath here, is a test fixture and not the estate. That global setting reaches
# EVERY repository on this machine, including the throwaway ones tests build in pytest's tmp_path
# and delete when they finish, and python-strict-default graded their two-line stand-ins as if
# they were estate source. Measured 2026-08-29 in idp: all three tests in
# tests/test_incident_spec_gate_touched_not_executed.py died inside their own fixture, before
# asserting anything, because `x=1` fails ruff format and a bare `scenarios("...")` fails ruff
# F821. Six more idp tests build a scratch repo the same way. A fence that refuses correct work
# is an outage (LAW 38), and the correct work here is the test of another guard.
#
# All three conditions are load-bearing, because this repository's OWN guard tests build scratch
# repos under the temp directory and need the guards to fire in them:
#   - the checkout is under the temp directory      -- the operating system deletes it, so nothing
#                                                      load-bearing can live there
#   - no repository-local core.hooksPath            -- tests/test_python_strict.py sets one, which
#                                                      is a fixture asking to be graded on purpose
#   - this file is the one the GLOBAL setting names -- crew474's test runs a copy of this router
#                                                      from its own temp directory, and that copy
#                                                      is being tested, not leaking in
# A skip on any weaker predicate turns nine of this repository's own tests red; that is measured,
# not argued, and tests/test_incident_crew623_hooks_skip_a_throwaway_repo.py holds the line.
tmp_root="$(cd "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P || echo /tmp)"
tmp_root="${tmp_root%/}"
here="$(cd "$(dirname "$0")" && pwd -P)"
global_hooks="$(git config --global --get core.hooksPath || true)"
[ -n "$global_hooks" ] && global_hooks="$(cd "$global_hooks" 2>/dev/null && pwd -P || echo "")"
local_hooks="$(git config --local --get core.hooksPath || true)"
if [ -z "$local_hooks" ] && [ -n "$global_hooks" ] && [ "$here" = "$global_hooks" ]; then
	case "$(cd "$top" && pwd -P)/" in
	"$tmp_root"/* | /tmp/* | /private/tmp/* | /var/folders/*)
		exit 0
		;;
	esac
fi

hook="$top/.githooks/$name"

if [ -x "$hook" ]; then
	# pre-commit: the repo's own hook runs first, then the shared defaults below still run
	# (crew#620: idp and crew carry their own pre-commit, and the shell gate must not be
	# skippable by having one). Every other hook: the repo's own hook is the whole answer.
	if [ "$name" != "pre-commit" ]; then
		run "$hook" "$@"
	fi
	set +e
	"$hook" "$@"
	rc=$?
	set -e
	if [ "$rc" != 0 ]; then
		record "$rc"
		exit "$rc"
	fi
fi

# The repo does not carry this hook. Only pre-push refuses on absence, because
# that is the gate LAW 32 hangs off; every other hook is optional by design and
# blocking on it stops work for no stated reason.
if [ "$name" = "pre-push" ]; then
	# hooks/ is in this list because claude-guards keeps its own pre-push there,
	# and claude-guards is the repo that ships the LAW 32 gate. Without that entry
	# the one repo whose job is enforcing the gate was the one repo the gate could
	# not run in: every push from it was refused, with an install instruction
	# naming a directory it does not use.
	for d in scripts/hooks hooks; do
		if [ -x "$top/$d/pre-push" ]; then
			run "$top/$d/pre-push" "$@"
		fi
	done
	# No repository hook. Run the shared LAW 32 gate rather than refusing.
	#
	# Refusing on absence was measured on 2026-08-23 at 22:45: four of this machine's six
	# repositories could not push at all -- crew, hermes-v2, hermes-config and ~/.estate itself,
	# the repository that holds this router. An install instruction printed to a machine that
	# cannot push the installation is an outage wearing a fence's clothes, and the comments above
	# already say twice why that is the wrong trade. The law is still enforced; it is now
	# enforced by something every repository inherits instead of something each one must
	# remember to install.
	run "$(dirname "$0")/law32-default" "$@"
fi

# pre-commit gets a shared default too, for the same reason pre-push does: a gate
# each repository must remember to install is a gate most repositories do not have.
# It refuses a commit that stages a config file the service reading it cannot parse
# (LAW 45, 2026-08-24). It fails open on a missing python3 or a missing checker.
if [ "$name" = "pre-commit" ]; then
	# Three defaults, all must pass: config syntax, the shell standard, the Python standard (crew#620).
	for shared in "$(dirname "$0")/config-syntax-default" "$(dirname "$0")/shell-strict-default" "$(dirname "$0")/python-strict-default"; do
		if [ -x "$shared" ]; then
			set +e
			"$shared" "$@"
			rc=$?
			set -e
			if [ "$rc" != 0 ]; then
				record "$rc"
				exit "$rc"
			fi
		fi
	done
fi
record 0
exit 0
