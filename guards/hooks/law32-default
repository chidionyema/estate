#!/usr/bin/env bash
# The LAW 32 gate, in one place, for every repository that does not ship its own.
#
# Until 2026-08-23 22:18 the router refused outright when a repository carried no pre-push,
# on the reasoning that pre-push is the gate LAW 32 hangs off. Measured 40 minutes later:
# four of the six repositories on this machine could not push at all, ~/.estate itself among
# them -- the repository that holds the router. That is the shape the router's own comments
# already name twice: a fence that cannot be satisfied is an outage, not a fence.
#
# So absence no longer refuses. It runs this instead. The law is still enforced everywhere,
# and it is enforced by something a repository inherits rather than something each repository
# has to remember to install.
#
# What it refuses: a push carrying a `feat:` commit that adds no docs/demo/<name>.md and
# docs/onboarding/<name>.md, or whose pair is a heading with nothing under it. The floor is
# 200 characters of prose per file once headings and blank lines are stripped, because a gate
# an empty template satisfies teaches people to write empty templates.
#
# One-off escape: ALLOW_BRANCH_RECREATE=1 git push ...
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# git hands the refs being pushed on stdin. Read it so the caller does not block, even though
# the range below is computed from origin/main rather than from the refs.
cat >/dev/null || true

base="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)"
if ! git rev-parse --verify --quiet "$base" >/dev/null; then
  exit 0
fi

# crew#505, 2026-08-27: the range comes from the LOCAL origin/main. A stale one made this gate
# walk 13,908 commits (one git show each) and the push hung past five minutes, twice, with no
# output, and the ALLOW_BRANCH_RECREATE escape was only read after the walk. So: a range that
# no push of features could plausibly carry is refreshed once and then refused loudly, before
# a single commit is opened. The escape is honoured here, where it can still save the time.
max_range="${LAW32_MAX_RANGE:-500}"
count="$(git rev-list --count "$base"..HEAD 2>/dev/null || echo 0)"
if [ "$count" -gt "$max_range" ]; then
  if [ "${ALLOW_BRANCH_RECREATE:-}" = "1" ]; then exit 0; fi
  remote_name="${base%%/*}"
  branch_name="${base#*/}"
  timeout 30 git fetch --quiet "$remote_name" "$branch_name" 2>/dev/null || true
  count="$(git rev-list --count "$base"..HEAD 2>/dev/null || echo 0)"
  if [ "$count" -gt "$max_range" ]; then
    echo "LAW 32 gate: $base..HEAD is $count commits. That is a lineage switch or a stale $base," >&2
    echo "not a push of features, and this gate will not open $count commits one by one." >&2
    echo "Refresh:  git fetch $remote_name $branch_name   then push again." >&2
    echo "Lineage switch on purpose:  ALLOW_BRANCH_RECREATE=1 git push ..." >&2
    exit 1
  fi
fi
feats="$(git log --format='%H %s' "$base"..HEAD 2>/dev/null | grep -E '^[0-9a-f]+ feat(\(|:)' || true)"
[ -n "$feats" ] || exit 0

# Where a demo and an onboarding page may live. idp moved both under Diátaxis headings on
# 2026-08-28 (ADR 0002: a demo is a tutorial, an onboarding is a how-to) and this gate was not
# told, so from that day every `feat:` push out of idp was refused for pages that existed --
# measured 2026-08-29 on feat/commerce-primitive-dark, which carried the pair under the new
# names and was told `docs/demo/the.md is missing`. A fence that correct work cannot satisfy is
# an outage, not a fence (LAW 38), and this file's own header already says so about absence.
# Either layout satisfies the law: what LAW 32 asks for is the two pages, not their directory.
DEMO_DIRS="docs/demo docs/tutorials/demo"
ONBOARDING_DIRS="docs/onboarding docs/how-to/onboarding"

# The first of these paths that exists, or empty when none does.
first_existing() {
  for _d in $1; do
    [ -f "$_d/$2.md" ] && { printf '%s' "$_d/$2.md"; return; }
  done
}

# Does this pair exist and say something? Echoes the complaint, or nothing when it is fine.
pair_problem() {
  _n="$1"; _p=""
  for _k in demo onboarding; do
    case "$_k" in
      demo) _dirs="$DEMO_DIRS" ;;
      *)    _dirs="$ONBOARDING_DIRS" ;;
    esac
    _f="$(first_existing "$_dirs" "$_n")"
    if [ -z "$_f" ]; then
      # Name every place it looked, so the complaint is actionable in either layout.
      for _d in $_dirs; do _p="$_p\n  $_d/$_n.md is missing"; done
      continue
    fi
    _c="$(grep -v '^#' "$_f" | grep -v '^[[:space:]]*$' | tr -d '\n' | wc -c | tr -d ' ')"
    [ "$_c" -lt 200 ] && _p="$_p\n  $_f has $_c characters of prose, the floor is 200"
  done
  printf '%b' "$_p"
}

# Every complete pair this push adds, anywhere in the range. A feature's code and its two
# pages routinely land in different commits of one push, and that is normal work, not a
# feature shipped undocumented. Refusing it was measured on 2026-08-24: a push carrying
# `feat: enforce the documentation standard` in one commit and docs/demo/docs-standard.md
# plus docs/onboarding/docs-standard.md in the next was blocked, with the gate asking for
# docs/demo/enforce.md -- a name it had picked out of the sentence. That is the same class
# as the 2026-08-23 defect this file's previous fix addressed one instance of: the gate
# demanding that the pair be discoverable from the feat commit alone.
#
# The 2026-08-23 protection is kept, and it is the reason for claiming rather than merely
# looking. One well-documented feature must not excuse every other feat: commit beside it,
# so each feat: commit consumes a DISTINCT pair. Three features in a push need three pairs.
push_pairs="$(git log --format='%H' "$base"..HEAD 2>/dev/null \
  | while IFS= read -r _s; do
      git show --name-only --format= "$_s" 2>/dev/null \
        | sed -n -e 's#^docs/demo/\(.*\)\.md$#\1#p' -e 's#^docs/tutorials/demo/\(.*\)\.md$#\1#p'
    done | sort -u)"
claimed=""

missing=""
while IFS= read -r line; do
  [ -n "$line" ] || continue
  sha="${line%% *}"
  subject="${line#* }"
  # Pairs added by THIS commit, not by the push. Scoping the fallback to the push let one
  # well-documented feature excuse every other feat: commit beside it -- measured 2026-08-23,
  # when two controls that must fail both passed. A feature's docs are the ones it brought.
  added="$(git show --name-only --format= "$sha" 2>/dev/null | sed -n -e 's#^docs/demo/\(.*\)\.md$#\1#p' -e 's#^docs/tutorials/demo/\(.*\)\.md$#\1#p')"
  # feat(name): thing  ->  name
  # feat: thing        ->  first word of the description, lowercased
  scope="$(printf '%s' "$subject" | sed -n 's/^feat(\([^)]*\)).*/\1/p')"
  if [ -z "$scope" ]; then
    scope="$(printf '%s' "$subject" | sed 's/^feat: *//' | awk '{print tolower($1)}')"
  fi
  problem="$(pair_problem "$scope")"
  # The guess is only a guess. "feat: a pull request declares ..." derived the name "a" and
  # refused a push that carried both files under their real name, measured 2026-08-23. So when
  # the guessed pair is not there, accept any complete pair the push actually adds. A pair still
  # has to exist and still has to clear the 200-character floor; what is dropped is the demand
  # that its filename match a word this gate picked out of a sentence.
  if [ -n "$problem" ] && [ -n "$added" ]; then
    while IFS= read -r cand; do
      [ -n "$cand" ] || continue
      if [ -z "$(pair_problem "$cand")" ]; then
        problem=""
        claimed="$claimed $cand"
        break
      fi
    done <<< "$added"
  fi
  # Still nothing? Take an unclaimed complete pair from elsewhere in the same push.
  if [ -n "$problem" ] && [ -n "$push_pairs" ]; then
    while IFS= read -r cand; do
      [ -n "$cand" ] || continue
      case " $claimed " in *" $cand "*) continue ;; esac
      if [ -z "$(pair_problem "$cand")" ]; then
        problem=""
        claimed="$claimed $cand"
        break
      fi
    done <<< "$push_pairs"
  fi
  if [ -n "$problem" ]; then
    missing="$missing\n  (from: $subject)$problem"
  fi
done <<< "$feats"

[ -n "$missing" ] || exit 0

echo "pre-push blocked by LAW 32: a feature ships with a demo and an onboarding."
printf "%b\n" "$missing"
echo ""
echo "  a demo        what he sees when it runs, real output, command above it"
echo "                docs/demo/<name>.md, or docs/tutorials/demo/<name>.md under Diataxis"
echo "  an onboarding what it is for, what it costs, where it lives, how to stop it"
echo "                docs/onboarding/<name>.md, or docs/how-to/onboarding/<name>.md"
echo ""
echo "Or, for a one-off:  ALLOW_BRANCH_RECREATE=1 git push ..."
[ "${ALLOW_BRANCH_RECREATE:-}" = "1" ] || exit 1
exit 0
