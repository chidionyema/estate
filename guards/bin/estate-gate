#!/bin/sh
# estate-gate <label> <command> [args...]
#
# WHY THIS EXISTS. On 2026-08-23 this laptop carried a 1-minute load average of
# 104 on 8 cores. Thirty-seven scheduled jobs belong to the estate, nine of them
# fire every hour, and because every one of them sets RunAtLoad they all count
# from the same boot and therefore fire together. Several walk the whole disk.
# Six agent sessions run alongside them.
#
# At that load every timeout inside every script expires, so a job reports a
# failure that never happened. Fourteen jobs last exited non-zero and almost none
# of those were real defects. It looked like fourteen bugs. It was one condition.
#
# The fix is not to make the jobs faster. It is to stop them all running at once.
# A job that is deferred loses nothing: every one of them is on a timer and the
# next tick is minutes away.
#
# CONTRACT. Exit 0 when deferred, because a deferral is not a failure and launchd
# only stores a number. The real command's exit status is passed through
# untouched when it does run.
#
# OFF SWITCH:  ESTATE_GATE_OFF=1  in the job's environment, or remove the two
# leading arguments from its plist. Nothing else on the machine depends on it.

LABEL="$1"; shift
[ -n "$LABEL" ] || { echo "estate-gate: no label" >&2; exit 64; }
[ $# -gt 0 ] || { echo "estate-gate: nothing to run" >&2; exit 64; }
[ -n "$ESTATE_GATE_OFF" ] && exec "$@"

STATE="$HOME/.estate/state"
LOG="$STATE/gate.log"
SLOTS="${ESTATE_GATE_SLOTS:-2}"
mkdir -p "$STATE"

NCPU=$(sysctl -n hw.ncpu 2>/dev/null || echo 8)
MAXLOAD="${ESTATE_GATE_MAX_LOAD:-$((NCPU * 2))}"

note() { printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$LABEL" "$*" >> "$LOG"; }

#: WHY DEFERRAL IS BOUNDED. Founder, 2026-08-23: "silent failue is the worst kid
#: of failues". Deferring is not a failure and exit 0 is the right answer to
#: launchd, but a deferral that can repeat forever is. Measured on this machine
#: between 18:35 and 22:18 that day: 40 deferrals across 12 jobs, every one
#: reporting success while doing nothing. com.founder.estateaudit was deferred 4
#: times in a row, so its output sat 183 minutes old against a 120 minute
#: deadline, /audit refused to serve, and the founder's dashboard was dead while
#: every instrument pointed at it said green.
#:
#: So a job may lose its turn, but it may not lose its turn indefinitely. After
#: MAX_DEFERS consecutive deferrals it runs regardless of load, which bounds how
#: stale anything on this machine can get to MAX_DEFERS intervals by
#: construction rather than by anybody noticing.
DEFERS="$STATE/gate.defers.$LABEL"
LASTRUN="$STATE/gate.lastrun.$LABEL"
MAX_DEFERS="${ESTATE_GATE_MAX_DEFERS:-2}"

#: Exits 0 when it decides to defer. Returns normally when the job has waited
#: long enough and must now run, whatever the machine is doing.
#: The founder's standing rule is that a slow machine outranks everything, so a
#: job that has waited its turns does not simply barge in. Above the emergency
#: ceiling it gives up its turn again and says so with a NON-ZERO exit, which is
#: the whole point: launchd stores that number, the board reads it, and a job
#: that is not running stops looking like a job that is passing. Starved is a
#: state, and it is neither PASS nor FAIL.
EMERG_MAX="${ESTATE_GATE_EMERGENCY_LOAD:-$((NCPU * 4))}"

maybe_defer() {
  n=$(cat "$DEFERS" 2>/dev/null || echo 0)
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1))
  if [ "$n" -gt "$MAX_DEFERS" ]; then
    if awk -v l="$LOAD1" -v m="$EMERG_MAX" 'BEGIN{exit !(l+0 > m+0)}'; then
      note "STARVED $n consecutive deferrals, load=$LOAD1 over emergency=$EMERG_MAX: $*"
      echo "$n" > "$DEFERS"
      exit 75          #: EX_TEMPFAIL. Visibly not run, rather than quietly not run.
    fi
    note "FORCED after $n consecutive deferrals: $*"
    echo 0 > "$DEFERS"
    return 0
  fi
  echo "$n" > "$DEFERS"
  note "DEFERRED $n/$MAX_DEFERS $*"
  exit 0
}

#: Compare as numbers. awk compares as strings unless an operand is numeric, and
#: "104.76" > "12" is false as a string, which would have disarmed this entirely.
LOAD1=$(uptime | sed 's/.*averages*: *//' | awk '{print $1+0}')
if awk -v l="$LOAD1" -v m="$MAXLOAD" 'BEGIN{exit !(l+0 > m+0)}'; then
  maybe_defer "load=$LOAD1 over max=$MAXLOAD ncpu=$NCPU"
fi

#: One directory per slot. mkdir is atomic on every filesystem this runs on, which
#: is why it is the lock rather than a file plus a test.
SLOT=""
i=1
while [ "$i" -le "$SLOTS" ]; do
  D="$STATE/gate.slot.$i"
  if mkdir "$D" 2>/dev/null; then
    echo $$ > "$D/pid"; SLOT="$D"; break
  fi
  #: A slot whose owner is gone is a slot, not a queue. Reclaim it.
  P=$(cat "$D/pid" 2>/dev/null)
  if [ -n "$P" ] && ! kill -0 "$P" 2>/dev/null; then
    note "reclaimed stale slot $i from dead pid $P"
    rm -rf "$D"
    continue
  fi
  i=$((i + 1))
done

if [ -z "$SLOT" ]; then
  #: Same rule as the load check. Losing every turn to a busy neighbour is the
  #: identical failure with a different cause, so it gets the identical bound.
  maybe_defer "all $SLOTS slots busy load=$LOAD1"
  note "RUN without a slot: waited $MAX_DEFERS turns already"
else
  trap 'rm -rf "$SLOT"' EXIT INT TERM
  note "RUN load=$LOAD1 slot=$SLOT"
fi

#: A turn taken resets the count. Only CONSECUTIVE deferrals are the failure;
#: a job that ran an hour ago and is deferred once now is behaving correctly.
echo 0 > "$DEFERS"

"$@"
RC=$?

#: The timestamp of the last real run, per job, so a reader can tell PASS from
#: NOT RUN. Nothing could tell them apart before, which is exactly how a dead
#: dashboard kept reporting green.
date -u +%Y-%m-%dT%H:%M:%SZ > "$LASTRUN"
note "DONE rc=$RC"
exit $RC
