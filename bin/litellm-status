#!/usr/bin/env python3
"""litellm-status: is the estate router reachable with this laptop's key?

Prints `ok <n> models` (exit 0) or `none <reason>` (exit 3). Standard library only.
Written by the router's minimax lane through OpenCode as the crew#568 Phase 3 measurement
ticket (36 s, one file, smoke ok); the models URL keeps /v1, which the ticket asked for.
"""

import json
import os
import sys
import urllib.request
import urllib.error


def main():
    base_url = os.environ.get("LITELLM_BASE_URL")
    api_key = os.environ.get("LITELLM_API_KEY")

    if not base_url:
        print("none missing LITELLM_BASE_URL")
        sys.exit(3)

    if not api_key:
        print("none missing LITELLM_API_KEY")
        sys.exit(3)

    base = base_url.rstrip("/")
    if base.endswith("/v1"):
        base = base[:-3]

    health_url = f"{base}/health/liveliness"
    models_url = f"{base_url.rstrip('/')}/models"

    req = urllib.request.Request(health_url)  # noqa: S310
    req.add_header("Authorization", f"Bearer {api_key}")

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:  # noqa: S310
            if resp.status != 200:
                print(f"none health check failed: {resp.status}")
                sys.exit(3)
    except urllib.error.HTTPError as e:
        print(f"none health check failed: {e.code}")
        sys.exit(3)
    except urllib.error.URLError as e:
        print(f"none health check failed: {e.reason}")
        sys.exit(3)

    req = urllib.request.Request(models_url)  # noqa: S310
    req.add_header("Authorization", f"Bearer {api_key}")

    try:
        with urllib.request.urlopen(req, timeout=10) as resp:  # noqa: S310
            if resp.status != 200:
                print(f"none models endpoint failed: {resp.status}")
                sys.exit(3)
            data = json.load(resp)
            models = data.get("data", [])
            count = len(models)
            print(f"ok {count} models")
            sys.exit(0)
    except urllib.error.HTTPError as e:
        print(f"none models endpoint failed: {e.code}")
        sys.exit(3)
    except urllib.error.URLError as e:
        print(f"none models endpoint failed: {e.reason}")
        sys.exit(3)


if __name__ == "__main__":
    main()
